# copy to .env and fill in. .env is gitignored. the app's setup and settings cover your name,
# the hugging face token, the notes model and the mic channel, so these are optional.
# HF_TOKEN=hf_yourtokenhere

# uncomment once check_setup.py has downloaded and cached all models
# HF_HUB_OFFLINE=1

# split mode: audio hijack zoom recordings with your mic on one channel
# MIC_OWNER=Your Name
# MIC_CHANNEL=left

# meeting notes: local runs on this mac, claude sends transcript text (never audio) to anthropic
# SUMMARY_BACKEND=local
# the anthropic api key is best added in the native app's settings, which keep it in the
# macos keychain. a key here still works, and settings can move it to the keychain
# ANTHROPIC_API_KEY=sk-ant-yourkeyhere
# CLAUDE_MODEL=claude-opus-5-5
# LOCAL_SUMMARY_MODEL=mlx-community/Qwen3-30B-A3B-Instruct-2507-4bit

# obsidian folder with one note per project, read for the project picker
# PROJECT_INDEX_DIR=/path/to/vault/Project Index

# obsidian folder with one note per person, where teams and organizations are read and saved.
# settings can choose it instead, and a folder chosen there wins
# PEOPLE_DIR=/path/to/vault/Directory/People

# obsidian folder the send button copies finished notes into. settings can choose it instead
# MEETING_NOTES_DIR=/path/to/vault/Meeting Notes

# things 3 areas whose open projects to-dos can go to, comma separated
# THINGS_AREAS=Work Projects, Work General

# todoist api token, if you'd rather not keep it in the keychain from settings
# TODOIST_API_TOKEN=
