# copy to .env and fill in. .env is gitignored.
HF_TOKEN=hf_yourtokenhere

# uncomment once check_setup.py has downloaded and cached all models
# HF_HUB_OFFLINE=1

# split mode: audio hijack zoom recordings with your mic on one channel
MIC_OWNER=Your Name
MIC_CHANNEL=left

# meeting notes: local runs on this mac, claude sends transcript text (never audio) to anthropic
SUMMARY_BACKEND=local
# ANTHROPIC_API_KEY=sk-ant-yourkeyhere
# CLAUDE_MODEL=claude-opus-5-5
# LOCAL_SUMMARY_MODEL=mlx-community/Qwen3-30B-A3B-Instruct-2507-4bit

# obsidian folder with one note per project, read for the project picker
# PROJECT_INDEX_DIR=/path/to/vault/Project Index

# obsidian folder the send button copies finished notes into
# MEETING_NOTES_DIR=/path/to/vault/Meeting Notes
